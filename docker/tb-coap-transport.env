ZOOKEEPER_ENABLED=true
ZOOKEEPER_URL=zookeeper:2181

# Kafka configuration for transport communication with tb-core
TB_QUEUE_TYPE=kafka
TB_KAFKA_SERVERS=kafka:9092

# Retry configuration for slow Kafka operations (for Raspberry Pi)
QUEUE_ROUTING_RETRIES=60
QUEUE_ROUTING_RETRY_INTERVAL=10000

COAP_BIND_ADDRESS=0.0.0.0
COAP_BIND_PORT=5683
COAP_TIMEOUT=10000

METRICS_ENABLED=true
METRICS_ENDPOINTS_EXPOSE=prometheus
WEB_APPLICATION_ENABLE=true
WEB_APPLICATION_TYPE=servlet
HTTP_BIND_PORT=8081
